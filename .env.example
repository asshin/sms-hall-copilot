# Leave LLM_API_KEY empty to run in heuristic mode (offline demo).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SEC=20
LLM_MAX_TOKENS=400
# Rough USD per 1M tokens for the cost estimator; adjust to your vendor.
LLM_INPUT_PRICE_PER_1M=0.14
LLM_OUTPUT_PRICE_PER_1M=0.28
